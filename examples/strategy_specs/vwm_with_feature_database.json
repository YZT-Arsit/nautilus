{
  "_comment": "Strategy spec with Feature Database integration. VWM signal engine reads pre-computed features from FeaturePipeline (Mode B). enable_order_submit must remain false; this config is for paper/backtest only.",
  "live": {
    "exchange_id": "binance",
    "symbol": "BTC/USDT:USDT",
    "timeframe": "1m",
    "warmup_bars": 200,
    "lookback_bars": 5
  },
  "strategy": {
    "name": "vwm_short",
    "requires_features": ["vwm_features_v1"],
    "feature_specs": {
      "vwm_features_v1": {
        "mom_len": 5,
        "avg_len": 20,
        "atr_len": 5
      }
    },
    "params": {
      "mom_len": 5,
      "avg_len": 20,
      "atr_len": 5,
      "atr_pcnt": 0.5,
      "setup_len": 5
    }
  },
  "data": {
    "source": "ccxt_ohlcv",
    "symbol": "BTC/USDT:USDT",
    "timeframe": "1m",
    "limit": 500
  },
  "feature_database": {
    "enabled": true,
    "store_path": "outputs/features/vwm_btcusdt_1m",
    "online_window_size": 500,
    "offline_flush_threshold": 1000,
    "write_mode": "append"
  },
  "execution": {
    "dry_run": true,
    "enable_order_submit": false,
    "_note": "enable_order_submit must remain false. Real order submission is not implemented."
  }
}
